-- Find the total price for order with orderid = 10266 and productID = 12
SELECT ROUND((UnitPrice * Quantity * (1 - Discount)), 2), *
FROM [Order Details]
WHERE OrderID = 10266;



-- Create a temporary table that contains the id of each order and the total revenues of that order
-- En SQLite usamos CREATE TEMP TABLE (o TEMPORARY)
CREATE TEMP TABLE tempFinalPrices AS
SELECT 
    O.OrderID, 
    SUM(ROUND((UnitPrice * Quantity * (1 - Discount)), 2)) AS [Final Price]
FROM Orders O
	INNER JOIN [Order Details] OD ON O.OrderID = OD.OrderID
GROUP BY O.OrderID;

SELECT * FROM tempFinalPrices;

DROP TABLE tempFinalPrices; -- la borro porque no la quiero permanente en la base de datos porque es para un consulta concreta que necsitaba



