-- Which customers have never made an order;
SELECT  C.CustomerID,
		C.CompanyName,
		COUNT(O.OrderID) AS [Total Count of Orders]
FROM Customers C
	LEFT JOIN Orders O ON C.CustomerID = O.CustomerID
GROUP BY C.CustomerID, C.CompanyName
HAVING COUNT(O.OrderID) = 0; --no hay clientes recogidos que no hayan hecho pedidos



