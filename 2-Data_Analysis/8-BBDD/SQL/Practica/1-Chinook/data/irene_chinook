--9.Cuántas canciones tiene ‘AC/DC’
SELECT COUNT(*) AS NumCanciones
FROM tracks
    INNER JOIN albums ON tracks.AlbumId = albums.AlbumId
    INNER JOIN artists ON albums.ArtistId = artists.ArtistId
WHERE artists.Name = 'AC/DC';


--10.Cuántos artículos tiene cada factura
SELECT InvoiceId, SUM(quantity) AS NumArticulos
FROM invoice_items
GROUP BY InvoiceId
ORDER BY NumArticulos DESC;


--11.Cuántas facturas hay de cada país
SELECT BillingCountry, COUNT(invoiceid) AS NumFacturas
FROM invoices
GROUP BY BillingCountry
ORDER BY NumFacturas DESC;


--12.Cuántas facturas ha habido en 2009 y 2011
SELECT strftime('%Y', InvoiceDate) AS Año,
COUNT(invoiceid) AS NumFacturas
FROM invoices
WHERE Año IN ('2009', '2011')
GROUP BY Año;


--13.Cuántas facturas ha habido entre 2009 y 2011

SELECT COUNT(invoiceid) AS NumFacturas
FROM invoices
WHERE strftime('%Y', invoices.InvoiceDate) BETWEEN '2009' AND '2011';


--14.Cuántas clientes hay de España y de Brasil

SELECT Country, COUNT(customerid) AS NumClientes
FROM customers
WHERE Country IN ('Spain', 'Brazil')
GROUP BY Country;



--15.Obtén las canciones que su título empieza por ‘You’

SELECT tracks.Name
FROM tracks
WHERE tracks.Name LIKE 'You%';



